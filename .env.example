DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- Email alerts (legacy pattern — SMTP username/password) ---
# NOTE: this matches health_monitor.py's current email code, built for
# a different account. Outlook/support@trinitytreepsych.com needs OAuth
# instead (Microsoft deprecated plain SMTP auth) — this block will
# likely be replaced once that work lands, not something to copy for
# the new notification system.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_TO_EMAIL=
SMTP_USE_TLS=

# --- Google Sheets Settings ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=config/service_account.json

# --- Dropbox Paths ---
# Personal to your own sandbox — depends on your app's access type, not shared.
# App Folder access: short paths, e.g. /incoming_pdfs
# Full Dropbox access: full paths, e.g. /Apps/<your-app-name>/incoming_pdfs
DROPBOX_INPUT_FOLDER=
DROPBOX_PROCESSED_PDF_FOLDER=
DROPBOX_SCHEDULE_FOLDER=