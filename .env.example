DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- Email alerts (legacy pattern — SMTP username/password) ---
# NOTE: this matches health_monitor.py's current email code, built for
# a different account. Outlook/support@trinitytreepsych.com needs OAuth
# instead (Microsoft deprecated plain SMTP auth) — this block will
# likely be replaced once that work lands, not something to copy for
# the new notification system.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_TO_EMAIL=
SMTP_USE_TLS=

# --- Google Sheets Settings ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=config/service_account.json

# --- Dropbox Paths ---
# Personal to your own sandbox — depends on your app's access type, not shared.
# App Folder access: short paths, e.g. /incoming_pdfs
# Full Dropbox access: full paths, e.g. /Apps/<your-app-name>/incoming_pdfs
DROPBOX_INPUT_FOLDER=
DROPBOX_PROCESSED_PDF_FOLDER=
DROPBOX_SCHEDULE_FOLDER=

# Full Dropbox path to the year folder used by the screenshot matcher.
# Example: /Apps/<app-name>/2026
DROPBOX_YEAR_FOLDER=/Apps/<app-name>/2026

# --- Microsoft Graph (sends the reminder emails) ---
# See "Microsoft Graph Setup" in the README. These come from the app registration
# in the Microsoft Entra admin center. Never commit real values.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The mailbox the emails are sent from (the app sends as this account)
MICROSOFT_SENDER_EMAIL=

# --- Reminders ---
# Copied on the Day 11 overdue notice (the Director). Comma-separate several.
# A real send refuses to start if an entry isn't a valid address.
STAFF_CC_EMAILS=
# "python -m app.reminders --live --test" sends every email here instead of to the
# providers, marked [TEST]. Use an address you can read.
REMINDERS_TEST_RECIPIENT=
# Sending to the providers stays off unless this is exactly "true" (any capitals).
# Keep it false until Dr. has approved the wording of the emails.
REMINDERS_GO_LIVE=false